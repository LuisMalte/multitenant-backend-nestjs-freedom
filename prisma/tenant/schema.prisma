generator client {
  provider     = "prisma-client"
  output       = "../../generated/tenant/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      String    @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  reservationsUpdated Reservation[] @relation("ReservationUpdatedBy")

  @@map("users")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  reservations Reservation[]

  @@map("customers")
}

model Court {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  sport        String    @db.VarChar(100)
  pricePerHour Decimal   @db.Decimal(10, 2)
  status       String    @db.VarChar(100)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  reservations Reservation[]

  @@map("courts")
}

model Reservation {
  id         String    @id @default(uuid()) @db.Uuid
  date       DateTime  @db.Date
  startTime  DateTime  @db.Time(0)
  endTime    DateTime  @db.Time(0)
  status     String    @db.VarChar(100)

  customerId String    @db.Uuid
  courtId    String    @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  String?   @db.Uuid
  updatedBy  String?   @db.Uuid
  deletedAt  DateTime? @map("deleted_at")



  customer Customer @relation(fields: [customerId], references: [id])
  court    Court    @relation(fields: [courtId], references: [id])

  createdByUser User? @relation("ReservationCreatedBy", fields: [createdBy], references: [id])
updatedByUser User? @relation("ReservationUpdatedBy", fields: [updatedBy], references: [id])

  @@index([customerId])
  @@index([courtId])
  @@index([date])
  @@index([courtId, date])
  @@map("reservations")
}