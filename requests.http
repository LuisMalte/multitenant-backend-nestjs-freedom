### ==========================================
### 0. AUTHENTICATION
### ==========================================

### Login
# @name loginAuth
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-Tenant-Id: {{tenantId}}

{
  "email": "manual@test.com",
  "password": "password123"
}


### ==========================================
### 1. CUSTOMER CRUD - TEST DATA
### ==========================================

### Create Customer
# @name createCustomer
POST {{baseUrl}}/customers
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}

{
  "name": "Customer CRUD Test",
  "email": "customer.crud@test.com",
  "phone": "3001112233"
}


### List Customers
GET {{baseUrl}}/customers?page=1&limit=10
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Filter Customers
  GET {{baseUrl}}/customers?name=Customer
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Sort Customers
GET {{baseUrl}}/customers?sortBy=name&order=asc
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Get Customer By ID
GET {{baseUrl}}/customers/{{createCustomer.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Update Customer
PATCH {{baseUrl}}/customers/{{createCustomer.response.body.id}}
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}

{
  "phone": "3229998877"
}


### Verify Customer Update
GET {{baseUrl}}/customers/{{createCustomer.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Delete Customer
DELETE {{baseUrl}}/customers/{{createCustomer.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Verify Customer Soft Delete
GET {{baseUrl}}/customers/{{createCustomer.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### ==========================================
### 2. COURT CRUD - TEST DATA
### ==========================================

### Create Court
# @name createCourt
POST {{baseUrl}}/courts
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}

{
  "name": "Court CRUD Test",
  "sport": "Tennis",
  "pricePerHour": 50000,
  "status": "AVAILABLE"
}


### List Courts
GET {{baseUrl}}/courts?page=1&limit=10
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Filter Courts By Sport
GET {{baseUrl}}/courts?sport=Tennis
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Filter Courts By Name
GET {{baseUrl}}/courts?name=Court
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Sort Courts By Price
GET {{baseUrl}}/courts?sortBy=pricePerHour&order=asc
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Filter Courts By Status
GET {{baseUrl}}/courts?status=AVAILABLE
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Get Court By ID
GET {{baseUrl}}/courts/{{createCourt.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Update Court
PATCH {{baseUrl}}/courts/{{createCourt.response.body.id}}
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}

{
  "name": "Court CRUD Updated",
  "pricePerHour": 60000,
  "status": "MAINTENANCE"
}


### Verify Court Update
GET {{baseUrl}}/courts/{{createCourt.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Delete Court
DELETE {{baseUrl}}/courts/{{createCourt.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


### Verify Court Soft Delete
GET {{baseUrl}}/courts/{{createCourt.response.body.id}}
X-Tenant-Id: {{tenantId}}
Authorization: Bearer {{loginAuth.response.body.accessToken}}


